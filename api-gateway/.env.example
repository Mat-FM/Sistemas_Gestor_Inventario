APP_NAME=api-gateway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=json_stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Coinciden con el servicio db-api-gateway del docker-compose.yml de la raíz (puerto local 3307).
# Si cambia GATEWAY_DB_PASSWORD en el .env de la raíz, cambie también DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=gateway_db
DB_USERNAME=gateway
DB_PASSWORD=change_me

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sesión (RNF07)
# JWT_SECRET firma los tokens (HS256) y no tiene valor por defecto: debe tener al menos 32 caracteres.
# Genérelo con: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_MINUTES=60

# Primer administrador (lo crea el seeder; sin él nadie podría entrar)
# Ambas variables son obligatorias para ejecutar `php artisan migrate --seed`: el seeder falla si faltan.
# ADMIN_PASSWORD es temporal (se debe cambiar en el primer inicio de sesión) y sigue la política de contraseñas:
# mínimo 8 caracteres, al menos una letra y un número, y no más de 72 bytes. El seeder falla si no la cumple.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Límite de peticiones (RNF19)
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Proxies de confianza: IP o CIDR del Service/Ingress de Kubernetes que reenvía al Gateway, separados por comas
# (p. ej. 10.0.0.0/8). Solo de ellos se aceptan X-Forwarded-For/Host/Port/Proto; vacía, esas cabeceras se ignoran
# y $request->ip() es la IP que conecta, así que detrás de un proxy el límite de login por IP sería de todos.
# «*» (confiar en todos) se rechaza: permitiría falsificar la IP y esquivar ese límite.
TRUSTED_PROXIES=

# Descubrimiento de servicios (RNF14): nombres del DNS interno de Kubernetes
MS_CATALOGO_URL=http://ms-catalogo:8000
MS_PROVEEDORES_URL=http://ms-proveedores:8000
MS_INVENTARIO_URL=http://ms-inventario:3000
MS_COMPRAS_URL=http://ms-compras:3000
MS_NOTIFICACIONES_URL=http://ms-notificaciones:5000
MS_REPORTES_URL=http://ms-reportes:5000
