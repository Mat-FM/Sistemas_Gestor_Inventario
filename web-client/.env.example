APP_NAME=web-client
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Único servicio con el que se comunica (RNF14, RNF21)
API_GATEWAY_URL=http://localhost:8000
# Segundos que se espera al Gateway. Es mayor que los 3 s que el Gateway espera a cada servicio, para ver su 503 en vez de
# cortar antes.
API_GATEWAY_TIMEOUT=5

# Sin base de datos: la sesión viaja cifrada en una cookie y el caché es de archivos.
# La sesión dura lo mismo que el token del Gateway (60 minutos).
SESSION_DRIVER=cookie
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=null

LOG_CHANNEL=json_stderr
LOG_LEVEL=debug

# IP o CIDR de los proxies (Ingress) que ponen X-Forwarded-For delante de este servicio, separados por comas. Vacío: ninguno.
# Con ella la IP real de cada usuario llega al Gateway y su límite de inicios de sesión cuenta por usuario. Nunca «*».
TRUSTED_PROXIES=
