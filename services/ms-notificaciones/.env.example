SERVICE_NAME=ms-notificaciones
PORT=5000
LOG_LEVEL=INFO

# Base de datos propia (RNF02). Fuera de Docker se usa el puerto publicado por docker-compose (5435).
DB_HOST=127.0.0.1
DB_PORT=5435
DB_NAME=notificaciones_db
DB_USER=notificaciones
DB_PASSWORD=change_me

# Llamadas entre servicios (RNF14, RNF18). Es la dirección real dentro del clúster y de Docker Compose.
# Si corre ms-notificaciones fuera de Docker, cambie el nombre por la dirección donde esté ms-inventario.
MS_INVENTARIO_URL=http://ms-inventario:3000
CALL_TIMEOUT_SECONDS=3

# Revisión diaria de vencimientos y stock bajo (se apaga con false, por ejemplo en las pruebas).
REVISION_DIARIA_ACTIVA=true

# Servidor de correo externo. Sin SMTP_HOST y MAIL_FROM las alertas solo se ven en la interfaz.
# Con el puerto 465 se usa SSL; con otro, STARTTLS si el servidor lo ofrece.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
