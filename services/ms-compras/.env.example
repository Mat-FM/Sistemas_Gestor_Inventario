SERVICE_NAME=ms-compras
PORT=3000
LOG_LEVEL=info

# Base de datos propia (RNF02). Fuera de Docker se usa el puerto publicado por docker-compose (5434).
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=compras_db
DB_USER=compras
DB_PASSWORD=change_me
# Conexiones a la base y cuánto espera una petición por una libre (o por conectar, si la base no responde) antes de
# responder 503. Debe ser menor que los 3 s que el Gateway espera por toda la respuesta.
DB_POOL_MAX=10
DB_POOL_TIMEOUT_MS=2000

# Llamadas entre servicios (RNF14, RNF18). Son las direcciones reales dentro del clúster y de Docker Compose.
# Si corre ms-compras fuera de Docker, cambie el nombre por la dirección donde esté cada servicio
# (por ejemplo http://127.0.0.1:3000 para ms-inventario).
MS_INVENTARIO_URL=http://ms-inventario:3000
MS_NOTIFICACIONES_URL=http://ms-notificaciones:5000
CALL_TIMEOUT_MS=3000
