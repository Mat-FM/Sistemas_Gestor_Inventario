APP_NAME=ms-proveedores
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Coinciden con el servicio db-ms-proveedores del docker-compose.yml de la raíz (puerto local 3309).
# Si cambia PROVEEDORES_DB_PASSWORD en el .env de la raíz, cambie también DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3309
DB_DATABASE=proveedores_db
DB_USERNAME=proveedores
DB_PASSWORD=change_me

# El servicio es una API sin estado: no usa sesiones, caché compartida ni colas.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
