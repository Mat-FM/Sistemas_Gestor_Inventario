# Lo que no debe entrar a la imagen: dependencias instaladas en el equipo, secretos locales, pruebas y archivos
# generados. Las dependencias se instalan dentro de la imagen con Composer.
vendor/
node_modules/
.env
tests/
phpunit.xml
.phpunit.result.cache
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*.php
bootstrap/cache/*.php
database/*.sqlite
.git
Dockerfile
.dockerignore
