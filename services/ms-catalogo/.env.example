APP_NAME=ms-catalogo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=json_stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Coinciden con el servicio db-ms-catalogo del docker-compose.yml de la raíz (puerto local 3308).
# Si cambia CATALOGO_DB_PASSWORD en el .env de la raíz, cambie también DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=catalogo_db
DB_USERNAME=catalogo
DB_PASSWORD=change_me

# Dirección de ms-proveedores para el filtro de productos por proveedor (RF12, llamada 8).
# En el clúster se usa el nombre del servicio; en local, la dirección donde corra (por ejemplo http://127.0.0.1:8001).
MS_PROVEEDORES_URL=http://ms-proveedores:8000

# El servicio es una API sin estado: no usa sesiones, caché compartida ni colas.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
