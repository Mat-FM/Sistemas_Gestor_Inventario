# Variables del entorno local (docker-compose.yml).
# Copia este archivo a .env y cambia las contraseñas. Nunca subas el .env al repositorio.
# Cada servicio tiene su propia base de datos y sus propias credenciales (RNF02).

# --- MySQL (Laravel) ---
GATEWAY_DB_NAME=gateway_db
GATEWAY_DB_USER=gateway
GATEWAY_DB_PASSWORD=change_me
GATEWAY_DB_PORT=3307

CATALOGO_DB_NAME=catalogo_db
CATALOGO_DB_USER=catalogo
CATALOGO_DB_PASSWORD=change_me
CATALOGO_DB_PORT=3308

PROVEEDORES_DB_NAME=proveedores_db
PROVEEDORES_DB_USER=proveedores
PROVEEDORES_DB_PASSWORD=change_me
PROVEEDORES_DB_PORT=3309

# --- PostgreSQL (Express y Flask) ---
INVENTARIO_DB_NAME=inventario_db
INVENTARIO_DB_USER=inventario
INVENTARIO_DB_PASSWORD=change_me
INVENTARIO_DB_PORT=5433

COMPRAS_DB_NAME=compras_db
COMPRAS_DB_USER=compras
COMPRAS_DB_PASSWORD=change_me
COMPRAS_DB_PORT=5434

NOTIFICACIONES_DB_NAME=notificaciones_db
NOTIFICACIONES_DB_USER=notificaciones
NOTIFICACIONES_DB_PASSWORD=change_me
NOTIFICACIONES_DB_PORT=5435

REPORTES_DB_NAME=reportes_db
REPORTES_DB_USER=reportes
REPORTES_DB_PASSWORD=change_me
REPORTES_DB_PORT=5436

# --- Secretos de las aplicaciones (SIN valor aquí: se generan UNA vez y se guardan en tu .env) ---
# Cada línea trae el comando que genera su valor. Las APP_KEY deben ser las mismas en todas las copias de un servicio.
# JWT_SECRET (al menos 32 caracteres):  openssl rand -base64 48
JWT_SECRET=
# APP_KEY de cada aplicación Laravel:  echo "base64:$(openssl rand -base64 32)"
GATEWAY_APP_KEY=
CATALOGO_APP_KEY=
PROVEEDORES_APP_KEY=
WEB_APP_KEY=
# Primer administrador (contraseña temporal, al menos 8 caracteres con una letra y un número: se cambia al entrar).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Puertos publicados en el equipo (solo en 127.0.0.1) ---
# Cambia los que ya tengas ocupados por otros proyectos (3000, 5432 y 5433 son comunes).
# Opcionales: límites de peticiones del Gateway (RNF19: 100 por minuto y usuario, 10 inicios de sesión por minuto y IP). Solo se suben para
# medir el rendimiento (performance-tests/brayan-collazos): con los de siempre se mediría el límite y no el Gateway.
# GATEWAY_RATE_LIMIT_PER_MINUTE=100
# GATEWAY_LOGIN_RATE_LIMIT_PER_MINUTE=10
GATEWAY_PORT=8000
WEB_PORT=8080
INVENTARIO_PORT=3001
COMPRAS_PORT=3002
NOTIFICACIONES_PORT=5001
