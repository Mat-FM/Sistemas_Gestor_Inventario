# Variables del entorno local (docker-compose.yml).
# Copia este archivo a .env y cambia las contraseñas. Nunca subas el .env al repositorio.
# Cada servicio tiene su propia base de datos y sus propias credenciales (RNF02).

# --- MySQL (Laravel) ---
GATEWAY_DB_NAME=gateway_db
GATEWAY_DB_USER=gateway
